  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, task_id, scheduled_fire_time, attempt,\n            status         AS \"status: ExecutionStatus\",\n            latency_ms, response_code, error, created_at\n        FROM task_executions\n        WHERE task_id = $1\n        ORDER BY created_at DESC, id DESC\n        LIMIT $2 OFFSET $3\n        ",
