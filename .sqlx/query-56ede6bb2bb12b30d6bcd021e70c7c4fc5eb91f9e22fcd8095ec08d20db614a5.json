  "query": "\n                SELECT\n                    id, task_id, scheduled_fire_time, attempts,\n                    last_error, last_response_code, created_at\n                FROM dead_letter\n                WHERE task_id = $1\n                ORDER BY created_at DESC, id DESC\n                LIMIT $2 OFFSET $3\n                ",
