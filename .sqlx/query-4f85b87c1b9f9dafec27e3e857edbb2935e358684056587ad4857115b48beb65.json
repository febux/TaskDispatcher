{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id, name,\n                    spec_type      AS \"spec_type: SpecType\",\n                    cron_expr,\n                    interval_seconds,\n                    run_at,\n                    timezone,\n                    target_id,\n                    payload,\n                    status         AS \"status: SpecStatus\",\n                    catch_up       AS \"catch_up: CatchUpPolicy\",\n                    max_attempts,\n                    next_run,\n                    created_at,\n                    updated_at,\n                    version\n                FROM task_specs\n                WHERE status = $1\n                ORDER BY next_run ASC NULLS LAST, created_at DESC\n                LIMIT $2 OFFSET $3\n                ",
